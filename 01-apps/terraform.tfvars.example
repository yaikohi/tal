# Example Terraform/OpenTofu variables for the apps layer
# Copy this file to terraform.tfvars and customize for your environment

# Path to kubeconfig generated by the infrastructure layer
kubeconfig_path = "../00-infra/kubeconfig"

# NFS Server Configuration
# This should be your Proxmox host IP address
# To verify: SSH to Proxmox and run: ip addr show | grep "192.168.20"
nfs_server = "192.168.20.1"

# NFS Export Path
# This is the path exported by your NFS server
# To verify: SSH to Proxmox and run: showmount -e localhost
# Make sure this path exists and is properly exported with the right permissions
nfs_path = "/mnt/nfs/kubernetes"

# Example: If your NFS export is different, update it here:
# nfs_path = "/export/k8s"
# nfs_path = "/mnt/storage/kubernetes"
